#!/usr/bin/make -f

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_VERSION_UPSTREAM ?= $(shell dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//')

%:
	dh $@

override_dh_auto_build:
	$(MAKE) VERSION=$(DEB_VERSION_UPSTREAM) all

override_dh_auto_test:
	$(MAKE) VERSION=$(DEB_VERSION_UPSTREAM) test

override_dh_auto_install:
	$(MAKE) VERSION=$(DEB_VERSION_UPSTREAM) DESTDIR=$(CURDIR)/debian/tmp prefix=/usr \
		LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) install
	rm -f $(CURDIR)/debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/librate_adjusting_pcm_ring.a

override_dh_auto_clean:
	$(MAKE) clean
